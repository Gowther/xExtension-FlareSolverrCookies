<form action="<?= _url('extension', 'configure', 'e', rawurlencode($this->getName())) ?>" method="post">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

	<div class="form-group">
		<h4>FlareSolverr Cookies</h4>
		<p class="help">为「受保护域名」列表中的 feed 自动注入 FlareSolverr 解出的 <code>cf_clearance</code> cookie（含绑定 User-Agent）。平时照常直连抓取，只在 cookie 缺失 / 过期 / 被拒时才让 FlareSolverr 重新求解。cf_clearance 与来源 IP 绑定：FlareSolverr 与 FreshRSS 必须使用同一出口 IP（默认同机 / 同一 Docker 网络即满足）。</p>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-relay-mode">工作模式</label>
		<div class="group-controls">
			<select id="fsc-relay-mode" name="relay_mode" class="form-control">
				<option value="inject"<?= $this->relayMode() ? '' : ' selected="selected"' ?>>inject(cookie 注入直连,默认,快)</option>
				<option value="relay"<?= $this->relayMode() ? ' selected="selected"' ?>>relay(每次抓取都走 FlareSolverr 浏览器,最稳)</option>
			</select>
			<p class="help">inject:把求解的 cf_clearance 注入 cURL 直连,只解一次用到过期再换;relay:每次刷新都由 FlareSolverr 浏览器代为传输 —— 只适合「cookie 有效但 curl 仍被拒(TLS 指纹校验)」的站点。relay 需在系统配置里启用 API。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="flaresolverr_base_url">FlareSolverr base URL</label>
		<div class="group-controls">
			<input type="url" id="flaresolverr_base_url" name="flaresolverr_base_url" class="form-control"
				value="<?= htmlspecialchars($this->flaresolverrBaseUrl()) ?>" placeholder="http://flaresolverr:8191" />
			<p class="help">例如示例中 docker 网络内地址，或 <code>http://127.0.0.1:8191</code>。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-domains">受保护域名（逗号或换行分隔）</label>
		<div class="group-controls">
			<textarea id="fsc-domains" name="domains" class="form-control" rows="3"
				placeholder="forum.naixi.net"><?= htmlspecialchars(implode("\n", $this->configuredDomains())) ?></textarea>
			<p class="help">自动覆盖其子域；列表外的 feed 完全不受本扩展影响。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-max-timeout">FlareSolverr maxTimeout（毫秒）</label>
		<div class="group-controls">
			<input type="number" id="fsc-max-timeout" name="max_timeout_ms" class="form-control" min="20000" max="120000" step="1000"
				value="<?= (int)$this->maxTimeoutMs() ?>" />
			<p class="help">单次求解的浏览器等待上限。挑战较顽固时可调大到 120000。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-cookie-ttl">cookie 最长保留（秒）</label>
		<div class="group-controls">
			<input type="number" id="fsc-cookie-ttl" name="cookie_ttl" class="form-control" min="600" max="604800"
				value="<?= (int)$this->cookieTtl() ?>" />
			<p class="help">超过该时长后强制重新求解一次（即使站点仍接受该 cookie）。默认 21600（6 小时）。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-validate-interval">存活校验间隔（秒）</label>
		<div class="group-controls">
			<input type="number" id="fsc-validate-interval" name="validate_interval" class="form-control" min="60" max="86400"
				value="<?= (int)$this->validateInterval() ?>" />
			<p class="help">每隔该时长，在真正抓取前先发一个轻量 HEAD 请求确认 cookie 仍被接受；被拒则触发重新求解。默认 600。</p>
		</div>
	</div>

	<div class="form-group">
		<label class="control-label" for="fsc-purge">清除缓存</label>
		<div class="group-controls">
			<label class="checkbox">
				<input type="checkbox" id="fsc-purge" name="purge_cache" value="1" />
				保存时删除本机已缓存的所有 cf_clearance（下次刷新重新求解）
			</label>
		</div>
	</div>

	<div class="form-group form-actions">
		<div class="group-controls">
			<button type="submit" class="btn btn-important"><?= _t('gen.action.submit') ?></button>
			<button type="reset" class="btn"><?= _t('gen.action.cancel') ?></button>
		</div>
	</div>
</form>

<h4>当前已缓存的 clearance</h4>
<?php if ($this->relayMode()) : ?>
<?php $fscFirstDomain = $this->configuredDomains()[0] ?? 'forum.naixi.net'; ?>
<p class="help">
	relay 模式订阅地址(需先在 系统配置 → API 与短代码 中启用 API):
	<code><?= htmlspecialchars(rtrim(FreshRSS_Context::systemConf()->base_url, '/')
		. '/api/misc.php?ext=FlareSolverr%20Cookies&feed='
		. rawurlencode('https://' . $fscFirstDomain . '/forum.php?mod=rss')) ?></code>
	(示例地址按你的 feed 实际路径修改;必须使用 FreshRSS 的公网访问地址)
</p>
<?php endif; ?>
<?php $fscRows = $this->cacheStatusRows(); ?>
<?php if ($fscRows === []) : ?>
	<p class="help">暂无缓存。添加受保护 feed 并刷新一次后，这里会列出各域名的 cookie 求解时间与 User-Agent。</p>
<?php else : ?>
	<ul>
	<?php foreach ($fscRows as $fscRow) : ?>
		<li>
			<code><?= htmlspecialchars($fscRow['host']) ?></code>
			— 求解于 <?= (int)round($fscRow['age_s'] / 60) ?> 分钟前，
			UA: <code><?= htmlspecialchars($fscRow['ua']) ?></code>
		</li>
	<?php endforeach; ?>
	</ul>
<?php endif; ?>
